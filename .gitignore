.installed.cfg
*.egg
venv/
.venv/
ENV/

# ─── Node / React Frontend ────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local
.vite/

