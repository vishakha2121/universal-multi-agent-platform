develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/

# ─── Node / React Frontend ────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local
.vite/

# ─── Environment Variables (Bahut Zaroori) ────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

